{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "mobile app/build/web"
      ],
      "port": 8765
    },
    {
      "name": "laravel-api",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "serve",
        "--host=127.0.0.1",
        "--port=8000"
      ],
      "port": 8000
    }
  ]
}
